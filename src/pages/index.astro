---
import { Picture } from "astro:assets";
import startupMentor from "../assets/startup-mentor-full.jpg";
import growthCoach from "../assets/growth-coach-full.jpg";
import productVisionary from "../assets/product-visionary-full.jpg";
import firstPrinciples from "../assets/first-principles-full.jpg";
import leverageCoach from "../assets/leverage-coach-full.jpg";
import commsStrategist from "../assets/comms-strategist-full.jpg";
const ADVISORS = [
  {
    name: "Startup Mentor",
    initials: "SM",
    figure: startupMentor,
    description:
      "Helps founders make something people want, talk to users, and grow from zero. Inspired by the work of Paul Graham.",
    href: "https://x.ai/bot/OR9xaJi0ap3jtuirzUAAU",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/startup-mentor",
  },
  {
    name: "Growth Coach",
    initials: "GC",
    image: "/growth-coach.png",
    figure: growthCoach,
    description:
      "Helps business owners grow their businesses, build better offers, and make more sales. Inspired by the work of Alex Hormozi.",
    href: "https://x.ai/bot/DM-Hu5vKEEuCGhWPGtG-b",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/growth-coach",
  },
  {
    name: "Product Visionary",
    initials: "PV",
    figure: productVisionary,
    description:
      "Helps founders build products people love through taste, focus, and saying no to almost everything. Inspired by the work of Steve Jobs.",
    href: "https://x.ai/bot/pOWbtYiP9qDudJ7KJXTwz",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/product-visionary",
  },
  {
    name: "First Principles Thinker",
    initials: "FP",
    figure: firstPrinciples,
    description:
      "Helps founders break hard problems down to the fundamentals and rebuild bold, better solutions. Inspired by the work of Elon Musk.",
    href: "https://x.ai/bot/extJjW6Rc37NOO4X2Dn71",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/first-principles-thinker",
  },
  {
    name: "Modern Philosopher",
    initials: "MP",
    figure: leverageCoach,
    description:
      "Helps you build wealth without getting lucky, make better decisions, and find peace along the way. Inspired by the work of Naval Ravikant.",
    href: "https://x.ai/bot/ahniZNOmREahmxbyPe788",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/modern-philosopher",
  },
  {
    name: "Comms Strategist",
    initials: "CS",
    figure: commsStrategist,
    description:
      "Helps leaders go direct, tell their own story, and win the narrative without relying on the press. Inspired by the work of Lulu Cheng Meservey.",
    href: "https://x.ai/bot/L5KyOBJoM0dGifDH2Y4x3",
    skill: "https://github.com/lukefernandez/trusted-advisors/tree/main/skills/comms-strategist",
  },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trusted Advisors</title>
<meta name="description" content="AI advisors that give great business advice">
<link rel="preload" href="/fonts/eb-garamond-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
<style is:global>
  @font-face { font-family:"EB Garamond"; font-style:normal; font-weight:400 800; font-display:swap; src:url(/fonts/eb-garamond-latin.woff2) format("woff2"); }
  @font-face { font-family:"Geist"; font-style:normal; font-weight:100 900; font-display:swap; src:url(/fonts/geist-latin.woff2) format("woff2"); }
  .card.has-figure > picture { display:flex; flex:none; align-self:flex-end; }
  :root { --bg:#fff; --text:#0a0a0a; --muted:#6b6b6b; --border:#e8e8e8; --soft:#f5f5f5; --section-gap:80px; }
  @media (max-width:900px) { :root { --section-gap:72px; } }
  @media (max-width:639px) { :root { --section-gap:56px; } }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--text); font:16px/1.5 "Geist",ui-sans-serif,system-ui,sans-serif; -webkit-font-smoothing:antialiased; }
  .wrap { max-width:1040px; margin:0 auto; padding:0 24px; }
  header .wrap { height:72px; display:flex; align-items:center; justify-content:center; }
  .brand { display:inline-flex; align-items:center; gap:10px; font-family:"EB Garamond",Georgia,serif; font-weight:500; font-size:21px; letter-spacing:.005em; text-decoration:none; color:inherit; }
  .brand img { width:30px; height:30px; display:block; }
  .hero { padding:72px 0 var(--section-gap); text-align:center; display:flex; flex-direction:column; align-items:center; }
  h1 { font-family:"EB Garamond",Georgia,serif; font-size:clamp(30px,4.8vw,46px); line-height:1.05; letter-spacing:-0.015em; font-weight:500; margin:0; max-width:30ch; text-wrap:pretty; }
  .lede { color:var(--muted); font-size:17px; max-width:44ch; margin:20px auto 0; text-wrap:balance; }
  .lede.after { text-align:center; margin:var(--section-gap) auto 0; padding-bottom:80px; max-width:56ch; text-wrap:pretty; }
  .grid { display:grid; gap:40px 24px; grid-template-columns:repeat(2,minmax(0,1fr)); padding-bottom:0; }
  .card { border:1px solid var(--border); border-radius:16px; padding:24px; display:flex; flex-direction:column; gap:16px; }
  .avatar { width:72px; height:72px; border-radius:999px; background:var(--soft); display:grid; place-items:center; font-weight:600; overflow:hidden; }
  .avatar img { width:100%; height:100%; object-fit:cover; object-position:50% 50%; }
  @keyframes bob { 0%,100% { transform:translateY(0) scale(1.04); } 50% { transform:translateY(-2px) scale(1.07); } }
  @media (prefers-reduced-motion: reduce) { .avatar img { animation:none; } }
  .card h2 { font-size:18px; font-weight:500; letter-spacing:-0.01em; margin:0; }
  .card p { margin:0; color:var(--muted); font-size:15px; text-wrap:balance; }
  .btn { align-self:flex-start; margin-top:4px; display:inline-flex; align-items:center; min-height:40px; padding:0 18px; border-radius:999px; background:var(--text); color:#fff; font-size:14px; font-weight:500; text-decoration:none; transition:opacity .15s, transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
  @media (hover:hover) and (pointer:fine) { .btn:hover { opacity:.85; } }
  .btn { white-space:nowrap; }
  .btn:active { transform:scale(0.96); }
  .btns { display:flex; flex-wrap:wrap; gap:8px; margin-top:4px; }
  .btns .btn { margin-top:0; }
  .btn-2 { background:#ececec; color:var(--text); }
  .btn:focus-visible { outline:2px solid var(--text); outline-offset:3px; }
  .card.has-figure { flex-direction:row; align-items:center; gap:20px; padding:0; border:none; }
  .figure { width:96px; height:auto; aspect-ratio:331/706; flex:none; align-self:flex-end; }
  .body { display:flex; flex-direction:column; gap:12px; }
  @media (prefers-reduced-motion: reduce) { .figure { animation:none; } }
  .body { min-width:0; }
  @media (max-width:900px) { .grid { gap:36px 20px; } .card.has-figure { gap:14px; } .figure { width:72px; } .btns { gap:6px; } .btns .btn { min-height:38px; padding:0 13px; font-size:13px; } }
  @media (min-width:640px) and (max-width:759px) { .wrap { padding:0 20px; } .grid { gap:36px 16px; } .card.has-figure { gap:12px; } .figure { width:60px; } .btns .btn { padding:0 11px; font-size:12.5px; min-height:36px; } }
  @media (min-width:640px) and (max-width:689px) { .figure { width:52px; } .card.has-figure { gap:10px; } .btns { gap:5px; } .btns .btn { padding:0 10px; font-size:12px; } }
  @media (max-width:639px) {
    .wrap { padding:0 20px; }
    header .wrap { height:64px; }
    .hero { padding:44px 0 var(--section-gap); }
    h1 { font-size:clamp(28px,7.6vw,34px); line-height:1.1; max-width:none; }
    .grid { grid-template-columns:1fr; gap:48px; }
    .card.has-figure { gap:16px; }
    .figure { width:76px; }
    .card p { font-size:15px; line-height:1.5; }
    .btns { gap:8px; }
    .btns .btn { min-height:38px; padding:0 14px; font-size:13.5px; }
    .lede.after { font-size:15px; padding-bottom:56px; }
  }
  @media (max-width:360px) { .btns .btn { flex:1 1 100%; justify-content:center; } }
  .soon { border-style:dashed; justify-content:center; align-items:center; color:var(--muted); font-size:14px; min-height:160px; }
  .card.has-figure .figure { transform-origin:50% 100%; cursor:pointer; transition:transform 160ms cubic-bezier(0.23, 1, 0.32, 1); }
  .card.has-figure .figure:active { transform:scale(0.96); }
  .card { transition:opacity 450ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 60ms), translate 450ms cubic-bezier(0.23, 1, 0.32, 1) calc(var(--i, 0) * 60ms); }
  @starting-style { .card { opacity:0; translate:0 8px; } }
  .js .card.has-figure .figure:not(.loaded) { opacity:0; translate:0 6px; }
  .card.has-figure .figure { transition:transform 160ms cubic-bezier(0.23, 1, 0.32, 1), opacity 400ms cubic-bezier(0.23, 1, 0.32, 1), translate 400ms cubic-bezier(0.23, 1, 0.32, 1); }
  @media (prefers-reduced-motion: reduce) { .card, .card.has-figure .figure { transition:none; } .js .card.has-figure .figure:not(.loaded) { opacity:1; translate:none; } }
  @media (prefers-reduced-motion: reduce) { .btn:active { transform:none; } .card.has-figure .figure { transition:none; } .card.has-figure .figure:active { transform:none; } }
</style>
</head>
<body>
<header><div class="wrap"><a class="brand" href="#"><img src="/logo.svg" alt="" width="30" height="30" />Trusted Advisors</a></div></header>
<script is:inline>document.documentElement.classList.add("js")</script>
<main class="wrap">
  <section class="hero">
    <h1>Chat with some of the most impactful minds of our time.</h1>
    <p class="lede">In blind, AI-judged tests, the advisors beat the same model without their skills <span style="white-space:nowrap">92% of the time.</span></p>
  </section>
  <div class="grid">
    {ADVISORS.map((a, i) => a.figure ? (
      <article class="card has-figure" style={`--i:${i}`}>
        <Picture class="figure" pictureAttributes={{ class: "figure-pic" }} src={a.figure} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[192, 288]} sizes="96px" alt={a.name} width={331} height={706} decoding="async" loading={i < 2 ? "eager" : "lazy"} fetchpriority={i < 2 ? "high" : undefined} />
        <div class="body"><h2>{a.name}</h2><p>{a.description}</p><div class="btns"><a class="btn" href={a.href}>Add to Grok Bot</a><a class="btn btn-2" href={a.skill} target="_blank" rel="noopener">Download skill</a></div></div>
      </article>
    ) : (
      <article class="card" style={`--i:${i}`}>
        <div class="avatar">{a.image ? <img src={a.image} alt="" /> : a.initials}</div>
        <h2>{a.name}</h2><p>{a.description}</p><div class="btns"><a class="btn" href={a.href}>Add to Grok Bot</a><a class="btn btn-2" href={a.skill} target="_blank" rel="noopener">Download skill</a></div>
      </article>
    ))}
  </div>
  <p class="lede after">Each advisor is a persona inspired by the public work of a well-known business thinker. They are independent creations and aren't affiliated with or endorsed by these thinkers.</p>
</main>
<script>
  for (const img of document.querySelectorAll<HTMLImageElement>(".figure")) {
    const done = () => img.classList.add("loaded");
    img.complete ? done() : (img.addEventListener("load", done, { once: true }), img.addEventListener("error", done, { once: true }));
  }
</script>
<script>
  // PostHog via the first-party /ingest proxy, loaded after the page is idle so it stays off the critical path.
  import { POSTHOG_KEY } from "../posthog";
  type PH = typeof import("posthog-js").default;
  let ph: PH | undefined;
  const queued: Array<(p: PH) => void> = [];
  const load = () => import("posthog-js").then(({ default: posthog }) => {
    posthog.init(POSTHOG_KEY, {
      api_host: "/ingest",
      ui_host: "https://us.posthog.com",
      defaults: "2025-11-30",
      capture_exceptions: true,
      debug: import.meta.env.DEV,
    });
    ph = posthog;
    for (const f of queued.splice(0)) f(posthog);
  });
  const idle = (cb: () => void) => ("requestIdleCallback" in window ? requestIdleCallback(cb, { timeout: 3000 }) : setTimeout(cb, 1500));
  document.readyState === "complete" ? idle(load) : addEventListener("load", () => idle(load), { once: true });

  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest?.("a.btn");
    if (!link) return;
    const advisor = link.closest("article")?.querySelector("h2")?.textContent;
    const send = (p: PH) => p.capture("get_bot_clicked", { advisor });
    ph ? send(ph) : queued.push(send);
  });
</script>
<script>
  // The click sound loads on the first sign of interaction, not on page load.
  let sound: Promise<typeof import("cuelume")> | undefined;
  const loadSound = () => (sound ??= import("cuelume").then((m) => (m.setTheme("bubble"), m)));
  for (const t of ["pointerdown", "pointerover", "touchstart", "keydown", "scroll"]) addEventListener(t, loadSound, { once: true, passive: true });
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const ease = "cubic-bezier(0.23, 1, 0.32, 1)";
  for (const el of document.querySelectorAll<HTMLElement>(".figure")) {
    el.addEventListener("click", () => {
      loadSound().then((m) => m.play("select"));
      if (reduced.matches) return;
      for (const a of el.getAnimations()) a.cancel();
      el.animate(
        [
          { translate: "0 0", scale: "1 1", rotate: "0deg", easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
          { translate: "0 0", scale: "1.07 .93", rotate: "0deg", offset: 0.14, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
          { translate: "0 -14px", scale: ".96 1.05", rotate: "-2deg", offset: 0.46, easing: "cubic-bezier(0.55, 0, 0.75, 0.3)" },
          { translate: "0 0", scale: "1.05 .95", rotate: "0.4deg", offset: 0.74, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)" },
          { translate: "0 0", scale: "1 1", rotate: "0deg" },
        ],
        { duration: 560 },
      );
    });
  }
</script>
</body>
</html>
